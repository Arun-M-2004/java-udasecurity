escription></BugCategory><BugCategory category='MALICIOUS_CODE'><Description>Malicious code vulnerability</Description></BugCategory><BugCategory category='STYLE'><Description>Dodgy code</Description></BugCategory><BugPattern abbrev='Se' category='BAD_PRACTICE' type='SE_BAD_FIELD_STORE'><ShortDescription>Non-serializable value stored into instance field of a serializable class</ShortDescription><Details>

